{
  "name": "privacyshield-ai",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node apps/demo-site/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:bundle": "node scripts/audit.mjs",
    "api": "node apps/api/server.mjs",
    "format": "prettier --write apps packages scripts tests *.ts *.js *.json"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "6.0.1",
    "tldts": "7.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.1.24",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.9",
    "eslint": "9.34.0",
    "prettier": "3.9.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "4.1.11"
  }
}
